---
import { SITE } from '../data/site';
import Icon from './Icon.astro';
interface Props {
  label?: string;
  location?: string;
  secondary?: boolean;
}
const {
  label = '前往 Chrome 应用商店',
  location = 'page',
  secondary = false,
} = Astro.props;
---

<a
  class:list={['button', secondary ? 'button-light' : 'button-primary']}
  href={SITE.store}
  target="_blank"
  rel="noopener noreferrer"
  data-store-link
  data-location={location}
>
  <Icon name="chrome" size={19} />
  {label}
  <Icon name="arrow" size={17} />
</a>
