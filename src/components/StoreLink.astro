---
import Icon from './Icon.astro';
interface Props {
  label?: string;
  location?: string;
  secondary?: boolean;
}
const {
  label = '选择浏览器安装',
  location = 'page',
  secondary = false,
} = Astro.props;
---

<a
  class:list={['button', secondary ? 'button-light' : 'button-primary']}
  href="/install/#browsers"
  data-location={location}
>
  <Icon name="download" size={19} />
  {label}
  <Icon name="arrow" size={17} />
</a>
