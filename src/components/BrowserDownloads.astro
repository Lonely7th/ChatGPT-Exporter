---
import { browsers } from '../data/site';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import chromeLogo from '../assets/browsers/chrome.png';
import edgeLogo from '../assets/browsers/edge.png';
import browser360Logo from '../assets/browsers/360.png';
import firefoxLogo from '../assets/browsers/firefox.png';
const browserLogos = {
  chrome: chromeLogo,
  edge: edgeLogo,
  '360': browser360Logo,
  firefox: firefoxLogo,
};
interface Props {
  compact?: boolean;
  location?: string;
}
const { compact = false, location = 'browser-downloads' } = Astro.props;
---

<div
  class:list={['browser-downloads', { compact }]}
  aria-label="浏览器安装入口"
>
  {browsers.map((browser) => (
    <a
      class={`browser-download browser-${browser.id}`}
      href={browser.href}
      target="_blank"
      rel="noopener noreferrer"
      data-store-link
      data-browser={browser.id}
      data-location={location}
      aria-label={`${browser.name} 安装入口（新窗口）`}
    >
      <span class="browser-badge" aria-hidden="true">
        <Image
          src={browserLogos[browser.id]}
          alt=""
          width={36}
          height={36}
          format="webp"
          densities={[1, 2]}
        />
      </span>
      <span>
        <strong>{browser.name}</strong>
        {!compact && <small>{browser.description}</small>}
      </span>
      <Icon name="arrow" size={16} />
    </a>
  ))}
</div>
