---
import { SITE } from '../data/site';
import { serializeJsonLd } from '../utils/seo';
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  parent?: string;
  parentHref?: string;
}
const { title, description, eyebrow, parent, parentHref } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.origin).href;
const items = [
  { name: '首页', url: `${SITE.origin}/` },
  ...(parent && parentHref
    ? [{ name: parent, url: new URL(parentHref, SITE.origin).href }]
    : []),
  { name: title, url: canonical },
];
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: item.url,
  })),
};
---

<script type="application/ld+json" set:html={serializeJsonLd(breadcrumb)} />
<section class="page-hero">
  <div class="container">
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href="/">首页</a>
      <span>/</span>
      {parent && (
        <>
          <a href={parentHref}>{parent}</a>
          <span>/</span>
        </>
      )}
      <span aria-current="page">{title}</span>
    </nav>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {description && <p class="lead">{description}</p>}
    <slot />
  </div>
</section>
