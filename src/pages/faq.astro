---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { faqs, SITE } from '../data/site';
---

<Base
  title={`常见问题：格式、公式、费用与隐私｜${SITE.name}`}
  description="了解 ChatGPT Exporter 的支持格式、公式转换、批量范围、登录与费用、联网处理和安装问题。"
>
  <PageHero
    title="常见问题，有话直说。"
    description="先了解能力与使用条件，再选择适合自己的导出方式。"
    eyebrow="帮助与支持"
  />
  <div class="container narrow">
    <div class="faq-list">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>
            {f.q}
            <span aria-hidden="true">＋</span>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <div class="inline-cta">
      <h2>还没找到答案？</h2>
      <p>
        先查看
        <a class="text-link" href="/guides/export-troubleshooting/">
          问题排查指南
        </a>
        ，也可以通过
        <a class="text-link" href="/about/">
          联系方式
        </a>
        提交脱敏后的复现信息。
      </p>
    </div>
  </div>
</Base>
